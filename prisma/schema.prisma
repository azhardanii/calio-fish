generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ReportSettings {
  id         String   @id @default(uuid())
  key        String   @unique
  value      Decimal  @default(0) @db.Decimal(14, 2)
  label      String
  updated_at DateTime @updatedAt
}

model Product {
  id           String             @id @default(uuid())
  sku          String             @unique
  name         String
  short_name   String
  category     String
  unit         String             @default("pcs")
  base_price   Decimal            @db.Decimal(12, 2)
  is_active    Boolean            @default(true)
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  stok             Int                @default(0)
  transactions     StockTransaction[]
  outbound_items   OutboundItem[]
  warehouse_stocks WarehouseStock[]
  outlet_stocks    OutletStock[]
}

model StockTransaction {
  id          String   @id @default(uuid())
  product_id  String
  type        String
  flow        String
  qty         Int
  balance     Int
  description String?
  date        DateTime @db.Date

  source_type      String?  // WAREHOUSE, OUTLET
  source_id        String?
  destination_type String?  // WAREHOUSE, OUTLET
  destination_id   String?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model MarketingOffline {
  id                  String   @id @default(uuid())
  date                DateTime @db.Date
  jenis_penjualan     String?  @default("B2B")
  target_bulanan      Decimal  @default(0) @db.Decimal(14, 2)
  target_new_outlet   Int?     @default(0)
  jumlah_outlet_aktif Int      @default(0)
  total_outlet_baru   Int?     @default(0)
  target_omset_harian Decimal? @default(0) @db.Decimal(14, 2)
  omset_harian        Decimal  @default(0) @db.Decimal(14, 2)
  omset_mtd           Decimal  @default(0) @db.Decimal(14, 2)
  persentase          Decimal  @default(0) @db.Decimal(6, 2)
  gap                 Decimal  @default(0) @db.Decimal(14, 2)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  employee_id         String?
  employee            Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model MarketingOnline {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  platform        String
  target_bulanan  Decimal? @default(0) @db.Decimal(14, 2)
  target_harian   Decimal? @default(0) @db.Decimal(14, 2)
  target_mtd      Decimal  @default(0) @db.Decimal(14, 2)
  omset_harian    Decimal  @default(0) @db.Decimal(14, 2)
  total_omset_mtd Decimal  @default(0) @db.Decimal(14, 2)
  persentase      Decimal  @default(0) @db.Decimal(6, 2)
  gap             Decimal  @default(0) @db.Decimal(14, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model OutboundShipment {
  id              String         @id @default(uuid())
  date            DateTime       @db.Date
  destination_type String        // e.g. "E-Commerce", "Outlet", "Affiliate", "Influencer", "Sample"
  destination_name String?       // e.g. "Shopee", "Outlet Cabang A", "Affiliator Budi"
  outlet_id       String?
  affiliate_id    String?
  status          String         @default("SHIPPED") // "SHIPPED", "PENDING", "CANCELLED"
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  
  items           OutboundItem[]
  
  outlet          Outlet?        @relation(fields: [outlet_id], references: [id], onDelete: SetNull)
  affiliate       Affiliate?     @relation(fields: [affiliate_id], references: [id], onDelete: SetNull)
  employee_id     String?
  employee        Employee?      @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model OutboundItem {
  id              String           @id @default(uuid())
  shipment_id     String
  product_id      String
  qty             Int
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  
  shipment        OutboundShipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [product_id], references: [id], onDelete: Restrict)
}

model PembersihanKulit {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  bahan_beku_kg   Decimal  @default(0) @db.Decimal(8, 3)
  bahan_bersih_kg Decimal  @default(0) @db.Decimal(8, 3)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model Produksi {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  kegiatan        String
  jenis_produksi  String?  // basah/kering
  bahan_baku      Decimal? @db.Decimal(8, 3)
  bahan_jadi      Decimal? @db.Decimal(8, 3)
  total_hasil_pcs Int?
  hpp_batch       Decimal? @db.Decimal(14, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model StokBahan {
  id              String   @id @default(uuid())
  tanggal         DateTime @db.Date
  kategori        String   // KEMASAN, BUMBU, KARDUS
  jenis_ukuran    String
  masuk           Int      @default(0)
  keluar          Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model Affiliate {
  id              String   @id @default(uuid())
  nama            String
  akun_medsos     String
  no_hp           String?
  alamat          String?
  jenis_postingan String?
  media_upload    String?
  ratecard        Decimal? @db.Decimal(14, 2)
  link_unggahan   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  shipments       OutboundShipment[]
  jadwal          JadwalKOL[]
}

model JadwalKOL {
  id                  String   @id @default(uuid())
  affiliate_id        String
  jadwal_kirim        DateTime? @db.Date
  jadwal_pengerjaan   String?   
  estimasi_upload     DateTime? @db.Date
  status              String    @default("TERJADWAL")
  
  affiliate           Affiliate @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  employee_id         String?
  employee            Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model DistribusiSample {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  jenis_sample    String
  total_produk    Int      @default(0)
  biaya_ekspedisi Decimal  @default(0) @db.Decimal(14, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
}

model Outlet {
  id           String   @id @default(uuid())
  nama         String
  tlp          String?
  alamat       String?
  status       String?
  pic          String?
  order_baru   Int      @default(0)
  tagihan      Decimal  @default(0) @db.Decimal(14, 2)
  payment      Decimal  @default(0) @db.Decimal(14, 2)
  sisa_tagihan Decimal  @default(0) @db.Decimal(14, 2)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  shipments    OutboundShipment[]
  stocks       OutletStock[]
}

model Warehouse {
  id         String   @id @default(uuid())
  name       String   // e.g. "Banyuwangi (factory)", "Malang (storage branch)"
  type       String   // e.g. "FACTORY", "STORAGE"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  stocks     WarehouseStock[]
}

model WarehouseStock {
  id           String   @id @default(uuid())
  warehouse_id String
  product_id   String
  quantity     Int      @default(0)
  returned_qty Int      @default(0) // Isolasi kerugian (retur rusak)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, product_id])
}

model OutletStock {
  id         String   @id @default(uuid())
  outlet_id  String
  product_id String
  quantity   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  outlet     Outlet  @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([outlet_id, product_id])
}

model Employee {
  id           String       @id @default(uuid())
  nama         String
  posisi       String?
  no_hp        String?      @unique
  status_aktif Boolean      @default(true)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  attendances  Attendance[]
  marketing_offline MarketingOffline[]
  marketing_online  MarketingOnline[]
  produksi          Produksi[]
  stok_bahan        StokBahan[]
  outbound_shipments OutboundShipment[]
  pembersihan_kulit PembersihanKulit[]
  jadwal_kol        JadwalKOL[]
  distribusi_sample DistribusiSample[]
}

model Attendance {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  employee_id      String
  status_kehadiran String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  alasan           String?
  waktu            DateTime @default(now())
  employee         Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
