generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ReportSettings {
  id         String   @id @default(uuid())
  key        String   @unique
  value      Decimal  @default(0) @db.Decimal(14, 2)
  label      String
  updated_at DateTime @updatedAt
}

model Product {
  id               String             @id @default(uuid())
  sku              String             @unique
  name             String
  short_name       String
  category         String
  unit             String             @default("pcs")
  base_price       Decimal            @db.Decimal(12, 2)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  stok             Int                @default(0)
  outbound_items   OutboundItem[]
  outlet_stocks    OutletStock[]
  transactions     StockTransaction[]
  warehouse_stocks WarehouseStock[]
  booth_stocks     BoothStock[]
  bundle_items     BoothBundleItem[]
}

model StockTransaction {
  id               String    @id @default(uuid())
  product_id       String
  type             String
  flow             String
  qty              Int
  balance          Int
  description      String?
  date             DateTime  @db.Date
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  destination_id   String?
  destination_type String?
  source_id        String?
  source_type      String?
  employee_id      String?
  employee         Employee? @relation(fields: [employee_id], references: [id])
  product          Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model MarketingOffline {
  id                  String    @id @default(uuid())
  date                DateTime  @db.Date
  target_bulanan      Decimal   @default(0) @db.Decimal(14, 2)
  jumlah_outlet_aktif Int       @default(0)
  omset_harian        Decimal   @default(0) @db.Decimal(14, 2)
  omset_mtd           Decimal   @default(0) @db.Decimal(14, 2)
  persentase          Decimal   @default(0) @db.Decimal(6, 2)
  gap                 Decimal   @default(0) @db.Decimal(14, 2)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  jenis_penjualan     String?   @default("B2B")
  target_new_outlet   Int?      @default(0)
  target_omset_harian Decimal?  @default(0) @db.Decimal(14, 2)
  total_outlet_baru   Int?      @default(0)
  employee_id         String?
  employee            Employee? @relation(fields: [employee_id], references: [id])
}

model MarketingOnline {
  id              String    @id @default(uuid())
  date            DateTime  @db.Date
  platform        String
  target_mtd      Decimal   @default(0) @db.Decimal(14, 2)
  omset_harian    Decimal   @default(0) @db.Decimal(14, 2)
  total_omset_mtd Decimal   @default(0) @db.Decimal(14, 2)
  persentase      Decimal   @default(0) @db.Decimal(6, 2)
  gap             Decimal   @default(0) @db.Decimal(14, 2)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  target_bulanan  Decimal?  @default(0) @db.Decimal(14, 2)
  target_harian   Decimal?  @default(0) @db.Decimal(14, 2)
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id])
}

model OutboundShipment {
  id               String         @id @default(uuid())
  date             DateTime       @db.Date
  destination_type String
  destination_name String?
  outlet_id        String?
  affiliate_id     String?
  status           String         @default("SHIPPED")
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  employee_id      String?
  notes            String?
  shipment_type    String?
  source_name      String?
  source_type      String?
  items            OutboundItem[]
  affiliate        Affiliate?     @relation(fields: [affiliate_id], references: [id])
  employee         Employee?      @relation(fields: [employee_id], references: [id])
  outlet           Outlet?        @relation(fields: [outlet_id], references: [id])
  booth_id         String?
  booth            EventBooth?    @relation(fields: [booth_id], references: [id])
}

model OutboundItem {
  id          String           @id @default(uuid())
  shipment_id String
  product_id  String
  qty         Int
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  product     Product          @relation(fields: [product_id], references: [id])
  shipment    OutboundShipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
}

model Produksi {
  id              String    @id @default(uuid())
  date            DateTime  @db.Date
  kegiatan        String
  bahan_baku      Decimal?  @db.Decimal(8, 3)
  bahan_jadi      Decimal?  @db.Decimal(8, 3)
  total_hasil_pcs Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  hpp_batch       Decimal?  @db.Decimal(14, 2)
  jenis_produksi  String?
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id])
}

model StokBahan {
  id           String    @id @default(uuid())
  tanggal      DateTime  @db.Date
  kategori     String
  jenis_ukuran String
  masuk        Int       @default(0)
  keluar       Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  employee_id  String?
  employee     Employee? @relation(fields: [employee_id], references: [id])
}

model Affiliate {
  id              String             @id @default(uuid())
  nama            String
  akun_medsos     String
  no_hp           String?
  alamat          String?
  jenis_postingan String?
  media_upload    String?
  ratecard        Decimal?           @db.Decimal(14, 2)
  link_unggahan   String?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  jadwal          JadwalKOL[]
  shipments       OutboundShipment[]
}

model JadwalKOL {
  id                String    @id @default(uuid())
  affiliate_id      String
  jadwal_kirim      DateTime? @db.Date
  jadwal_pengerjaan String?
  estimasi_upload   DateTime? @db.Date
  status            String    @default("TERJADWAL")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  employee_id       String?
  affiliate         Affiliate @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)
  employee          Employee? @relation(fields: [employee_id], references: [id])
}

model DistribusiSample {
  id              String    @id @default(uuid())
  date            DateTime  @db.Date
  jenis_sample    String
  total_produk    Int       @default(0)
  biaya_ekspedisi Decimal   @default(0) @db.Decimal(14, 2)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  employee_id     String?
  employee        Employee? @relation(fields: [employee_id], references: [id])
}

model Outlet {
  id           String             @id @default(uuid())
  nama         String
  tlp          String?
  alamat       String?
  wilayah      String?
  status       String?
  pic          String?
  order_baru   Int                @default(0)
  tagihan      Decimal            @default(0) @db.Decimal(14, 2)
  payment      Decimal            @default(0) @db.Decimal(14, 2)
  sisa_tagihan Decimal            @default(0) @db.Decimal(14, 2)
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  pengelola_id String?
  pengelola    Employee?          @relation("OutletPengelola", fields: [pengelola_id], references: [id])
  distributor_id String?
  distributor    Employee?          @relation("DistributorOutlets", fields: [distributor_id], references: [id])
  shipments    OutboundShipment[]
  stocks       OutletStock[]
  transactions OutletTransaction[]
}

model OutletTransaction {
  id          String   @id @default(uuid())
  outlet_id   String
  type        String
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  date        DateTime @default(now())
  created_at  DateTime @default(now())
  outlet      Outlet   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

model Warehouse {
  id             String           @id @default(uuid())
  name           String
  type           String
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  address        String?
  distributor_id String?
  distributor    Employee?        @relation("DistributorWarehouse", fields: [distributor_id], references: [id])
  stocks         WarehouseStock[]
}

model WarehouseStock {
  id           String    @id @default(uuid())
  warehouse_id String
  product_id   String
  quantity     Int       @default(0)
  returned_qty Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  product      Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, product_id])
}

model OutletStock {
  id         String   @id @default(uuid())
  outlet_id  String
  product_id String
  quantity   Int      @default(0)
  harga_beli Decimal? @db.Decimal(12, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  outlet     Outlet   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([outlet_id, product_id])
}

model Employee {
  id                 String             @id @default(uuid())
  nama               String
  posisi             String?
  role               String             @default("STAFF")
  no_hp              String?            @unique
  otp_code           String?
  otp_expires        DateTime?
  status_aktif       Boolean            @default(true)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  wilayah            String?
  attendances                  Attendance[]
  distribusi_sample            DistribusiSample[]
  jadwal_kol                   JadwalKOL[]
  marketing_offline            MarketingOffline[]
  marketing_online             MarketingOnline[]
  outbound_shipments           OutboundShipment[]
  produksi                     Produksi[]
  stockTransactions            StockTransaction[]
  stok_bahan                   StokBahan[]
  managed_outlets              Outlet[]                     @relation("OutletPengelola")
  marketing_targets            MarketingTarget[]
  personal_buyer_transactions  PersonalBuyerTransaction[]
  managed_booths               EventBooth[]                 @relation("BoothPIC")
  distributor_warehouses       Warehouse[]                  @relation("DistributorWarehouse")
  distributor_outlets          Outlet[]                     @relation("DistributorOutlets")
  expenses                     Expense[]
}

model Expense {
  id          String    @id @default(uuid())
  category    String    @default("OPERASIONAL")
  title       String
  amount      Decimal   @db.Decimal(14, 2)
  date        DateTime  @db.Date
  description String?
  employee_id String?
  employee    Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

model Attendance {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  employee_id      String
  status_kehadiran String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  alasan           String?
  waktu            DateTime @default(now())
  employee         Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model MarketingTarget {
  id            String   @id @default(uuid())
  employee_id   String
  bulan         Int
  tahun         Int
  target_omset  Decimal  @default(0) @db.Decimal(14, 2)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  employee      Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, bulan, tahun])
}

model PersonalBuyerTransaction {
  id             String   @id @default(uuid())
  employee_id    String
  buyer_name     String
  product_name   String?
  quantity       Int?     @default(1)
  price_per_unit Decimal? @db.Decimal(14, 2)
  amount         Decimal  @db.Decimal(14, 2)
  description    String?
  date           DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  employee       Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
}

model EventBooth {
  id                String             @id @default(uuid())
  nama              String
  lokasi            String?
  tanggal_mulai     DateTime           @db.Date
  tanggal_selesai   DateTime           @db.Date
  status            String             @default("AKTIF")
  pic_id            String?
  total_penjualan   Decimal            @default(0) @db.Decimal(14, 2)
  total_pengeluaran Decimal            @default(0) @db.Decimal(14, 2)
  kas_masuk         Decimal            @default(0) @db.Decimal(14, 2)
  catatan           String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  pic               Employee?          @relation("BoothPIC", fields: [pic_id], references: [id])
  stocks            BoothStock[]
  bundles           BoothBundle[]
  sales             BoothSale[]
  shipments         OutboundShipment[]
}

model BoothStock {
  id         String     @id @default(uuid())
  booth_id   String
  product_id String
  quantity   Int        @default(0)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  booth      EventBooth @relation(fields: [booth_id], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([booth_id, product_id])
}

model BoothBundle {
  id         String            @id @default(uuid())
  booth_id   String
  nama       String
  sku        String?
  harga_jual Decimal           @db.Decimal(12, 2)
  is_active  Boolean           @default(true)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  booth      EventBooth        @relation(fields: [booth_id], references: [id], onDelete: Cascade)
  items      BoothBundleItem[]
  sales      BoothSale[]
}

model BoothBundleItem {
  id         String      @id @default(uuid())
  bundle_id  String
  product_id String
  qty        Int         @default(1)

  bundle     BoothBundle @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([bundle_id, product_id])
}

model BoothSale {
  id                String       @id @default(uuid())
  booth_id          String
  bundle_id         String?
  product_id        String?
  item_name         String
  qty               Int          @default(1)
  unit_price        Decimal      @db.Decimal(12, 2)
  total_price       Decimal      @db.Decimal(14, 2)
  metode_pembayaran String       @default("TUNAI")
  date              DateTime     @default(now())
  catatan           String?
  employee_id       String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  booth             EventBooth   @relation(fields: [booth_id], references: [id], onDelete: Cascade)
  bundle            BoothBundle? @relation(fields: [bundle_id], references: [id])
}

